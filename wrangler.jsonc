{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-coding",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "kv_namespaces": [
    // 在 Cloudflare 控制台 Storage & Databases → KV 创建命名空间后，把 ID 填到这里
    { "binding": "STORE", "id": "<KV_NAMESPACE_ID>" }
  ]
  // 管理密码请用 secret 设置，不要写在这里：
  //   npx wrangler secret put ADMIN_PASSWORD
}
